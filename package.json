{
  "name": "pdf-editor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run assets && vite",
    "app": "npm run assets && node scripts/dev.mjs",
    "build": "npm run assets && tsc && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "package:arch": "cd packaging/arch && makepkg -f",
    "test": "npm run build && node --test --test-concurrency=1 tests/app.test.mjs",
    "test:electron": "npm run build && node --test tests/electron.test.mjs"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^45.2.2",
    "lucide": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1"
  },
  "productName": "PDF Editor",
  "description": "PDF viewer and editor",
  "main": "electron/main.cjs"
}
